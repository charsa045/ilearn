generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        String   @id @default(cuid())
  nombre    String
  email     String   @unique
  createdAt DateTime @default(now())
}

model Asistencia {
  id        String   @id @default(cuid())
  claseId   String
  fecha     DateTime
  createdAt DateTime @default(now())
}